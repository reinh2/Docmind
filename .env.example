# Server
DOCMIND_HTTP_ADDR=:8080
DOCMIND_LOG_LEVEL=info
DOCMIND_DATABASE_URL=postgres://docmind:docmind@postgres:5432/docmind?sslmode=disable

# Demo mode uses deterministic local AI and needs no secret.
DOCMIND_AI_MODE=fake
# Set DOCMIND_AI_MODE=openrouter after providing these values.
OPENROUTER_API_KEY=
OPENROUTER_CHAT_MODEL=openai/gpt-4.1-mini
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small

# Ingestion and retrieval
DOCMIND_QUEUE_CAPACITY=32
DOCMIND_CHUNK_SIZE=900
DOCMIND_CHUNK_OVERLAP=160
DOCMIND_RETRIEVAL_THRESHOLD=0.01
DOCMIND_ADMIN_TOKEN=change-me-before-production
DOCMIND_CORS_ORIGINS=http://localhost:5173
DOCMIND_RATE_LIMIT_PER_MINUTE=60

# Optional Telegram channel: docker compose --profile telegram up
TELEGRAM_BOT_TOKEN=
